{
  "description": "Block commits on, and pushes to, the default branch so changes go through a pull request",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-default-branch.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
